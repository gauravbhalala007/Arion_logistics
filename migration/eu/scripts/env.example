# migration/eu/scripts/env.example
#
# Kopiere nach .env (ist gitignore'd) und fuelle die markierten Felder.

# ============ Projekt-IDs ============
OLD_PROJECT_ID="gaurav-arion-001-3d94a"
NEW_PROJECT_ID="codriver-eu"

# ============ Storage-Buckets ============
OLD_BUCKET="gaurav-arion-001-3d94a.firebasestorage.app"
NEW_BUCKET="codriver-eu.firebasestorage.app"

# ============ Backup-Bucket (auf altem Projekt fuer Export-Stage) ============
# Wird vom Script 03 automatisch angelegt, falls nicht vorhanden.
EXPORT_BUCKET="codriver-migration-staging"

# ============ Auth-Passwort-Hash-Parameter ============
# WICHTIG: Diese Werte holst du EINMALIG aus:
#   Firebase Console (OLD project) → Authentication → "..."-Menue oben
#   → "Project settings" → Hash Parameters
#
# Ohne diese Werte funktionieren importierte Passwoerter NICHT.
# Standard-Algorithmus von Firebase ist SCRYPT.
AUTH_HASH_KEY=""
AUTH_SALT_SEPARATOR=""
AUTH_ROUNDS="8"
AUTH_MEM_COST="14"

# ============ Region-Settings ============
NEW_FUNCTIONS_REGION="europe-west3"
NEW_FIRESTORE_LOCATION="eur3"
NEW_STORAGE_LOCATION="europe-west3"

# ============ Custom Domain ============
# Wird in Phase 3 (Cutover) verwendet, um die alte Domain
# auf das neue Projekt umzuhaengen.
CUSTOM_DOMAIN="dsp-codriver.de"
