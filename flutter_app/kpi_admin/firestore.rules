// ============================================================
// VERALTETE KOPIE - WIRD NICHT MEHR DEPLOYED.
// Massgeblich sind die Dateien in firebase/ (dort liegt die
// Backend-Konfiguration inkl. Functions und Indexes).
// Diese Datei bleibt nur als Referenz erhalten, bis geklaert ist,
// welcher Rules-Stand aktuell live in Firebase aktiv ist.
// Siehe DEPLOYMENT.md -> 'Offener Punkt: Firestore-Rules'.
// ============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Read the caller's user doc safely
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && me().data.role == 'admin';
    }

    function isApproved(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.approved == true;
    }

    // driver user created by Cloud Function
    function isDriver() {
      return signedIn() && me().data.role == 'driver';
    }

    function companyScope() {
      return ('dspUid' in me().data) && me().data.dspUid != null && me().data.dspUid != ''
        ? me().data.dspUid
        : request.auth.uid;
    }

    function roleValue() {
      return me().data.role == null ? '' : me().data.role;
    }

    function isApprovedFleetManager() {
      return signedIn()
        && isApproved(request.auth.uid)
        && roleValue().matches('(?i)^(admin|user|developer)$');
    }

    function isApprovedFleetViewer() {
      return signedIn()
        && isApproved(request.auth.uid)
        && roleValue().matches('(?i)^(admin|user|developer)$');
    }

    function fleetDocScope(data) {
      return  data.dspUid;
        
    }

    function isFleetStatus(value) {
      return value in ['active', 'grounded', 'in_service', 'defleeted'];
    }

    function isFleetType(value) {
      return value in [
        'armada',
        'amazon_paid_rental',
        'self_sourced_rental',
        'self_owned_rental',
      ];
    }

    function isFleetEventType(value) {
      return value in [
        'registration',
        'status_change',
        'tire_change',
        'service_maintenance',
        'tuv_inspection',
        'accident',
        'damage',
        'rental_contract_change',
        'note',
      ];
    }

    function optionalString(data, field) {
      return !(field in data) || data[field] == null || data[field] is string;
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] == null || data[field] is timestamp;
    }

    function optionalNumber(data, field) {
      return !(field in data) || data[field] == null || data[field] is number;
    }

    function validFleetVehicleData(data, userId, vehicleId) {
      return data.vehicleNumber == vehicleId
        && fleetDocScope(data) == userId
        && data.model is string
        && data.status is string
        && isFleetStatus(data.status)
        && data.fleetType is string
        && isFleetType(data.fleetType)
        && data.providerOrOwnerName is string
        && data.contractReference is string
        && data.notes is string
        && optionalTimestamp(data, 'contractStartDate')
        && optionalTimestamp(data, 'contractEndDate')
        && optionalTimestamp(data, 'serviceStartDate')
        && optionalTimestamp(data, 'serviceEndDate')
        && optionalNumber(data, 'monthlyRateEur')
        && optionalNumber(data, 'purchaseValueEur')
        && optionalTimestamp(data, 'createdAt')
        && optionalTimestamp(data, 'updatedAt');
    }

    // is the caller a driver that belongs to this DSP userId?
    // (requires users/{driverUid} to have a field "dspUid")
    function isDriverOf(userId) {
      return isDriver() && me().data.dspUid == userId;
    }

    // Fallback for legacy driver accounts that rely on custom claims.
    function isDriverOfByToken(userId) {
      return signedIn()
        && request.auth.token.role == 'driver'
        && request.auth.token.dspUid == userId;
    }

    function driverTransporterMatches(driverId) {
      return (isDriver() && me().data.transporterId == driverId)
        || (signedIn() && request.auth.token.role == 'driver'
          && request.auth.token.transporterId == driverId);
    }

    match /users/{userId} {
    
    	// ---------- admin notifications ----------
      match /notifications/{notificationId} {
        // Admin (DSP owner) can create + read notification history
        allow read, write: if isSelf(userId) && isApproved(userId);
      }
      
      // Created by the user at signup (DSP/admin + also driver profiles)
      allow create: if isSelf(userId);

      // Everyone can read their OWN user doc; admin can read all
      allow read: if isSelf(userId) || isAdmin();

      // Only admins may update/delete user docs (for now)
      allow update: if isAdmin() || isSelf(userId); 
      allow delete: if isAdmin();

      match /vehicles/{vehicleId} {
        allow get, list: if isApprovedFleetViewer() && userId == companyScope();

        allow create, update: if isApprovedFleetManager()
          && userId == companyScope()
          && validFleetVehicleData(request.resource.data, userId, vehicleId)
          && (!exists(/databases/$(database)/documents/users/$(userId)/vehicles/$(vehicleId))
            || fleetDocScope(resource.data) == userId)
          && (
            request.resource.data.fleetType == 'self_owned_rental'
              ? request.resource.data.providerOrOwnerName != ''
                && request.resource.data.purchaseValueEur is number
              : request.resource.data.providerOrOwnerName != ''
                && request.resource.data.contractReference != ''
                && request.resource.data.contractStartDate is timestamp
                && request.resource.data.monthlyRateEur is number
          );

        allow delete: if isApprovedFleetManager() && userId == companyScope();

        match /documents/{documentId} {
          allow get, list: if isApprovedFleetViewer() && userId == companyScope();

          allow create, update, delete: if isApprovedFleetManager()
            && userId == companyScope()
            && request.resource.data.type in ['tuv', 'insurance', 'service', 'rc']
            && request.resource.data.fileUrl is string
            && request.resource.data.fileName is string
            && request.resource.data.uploadedAt is timestamp
            && (!('expiryDate' in request.resource.data)
              || request.resource.data.expiryDate == null
              || request.resource.data.expiryDate is timestamp)
            && (!('storagePath' in request.resource.data)
              || request.resource.data.storagePath is string);
        }

        match /history/{historyId} {
          allow get, list: if isApprovedFleetViewer() && userId == companyScope();

          allow create, update: if isApprovedFleetManager()
            && userId == companyScope()
            && request.resource.data.eventType is string
            && isFleetEventType(request.resource.data.eventType)
            && request.resource.data.eventDate is timestamp
            && request.resource.data.title is string
            && request.resource.data.createdByUid is string
            && optionalString(request.resource.data, 'notes')
            && optionalString(request.resource.data, 'fileUrl')
            && optionalString(request.resource.data, 'fileName')
            && optionalString(request.resource.data, 'storagePath')
            && optionalTimestamp(request.resource.data, 'createdAt')
            && optionalTimestamp(request.resource.data, 'updatedAt');

          allow delete: if isApprovedFleetManager()
            && userId == companyScope();
        }
      }

      // ---------- reports (scorecards) ----------
      // users/{userId}/reports/{reportId}
      match /reports/{reportId} {
        // DSP itself can read + write its own reports (and must be approved)
        allow read: if isSelf(userId) && isApproved(userId);
        allow write: if isSelf(userId) && isApproved(userId);

        // Drivers of this DSP can READ reports (for dashboard)
        allow read: if isDriverOf(userId) && isApproved(userId);

        // per-report driver name mappings
        match /driverNames/{nameId} {
          // DSP full access
          allow read: if isSelf(userId) && isApproved(userId);
          allow write: if isSelf(userId) && isApproved(userId);

          // drivers of this DSP can read for display
          allow read: if isDriverOf(userId) && isApproved(userId);
        }
      }

      // ---------- scores for a report ----------
      // users/{userId}/scores/{scoreId}
      match /scores/{scoreId} {
        // DSP full access
        allow read: if isSelf(userId) && isApproved(userId);
        allow write: if isSelf(userId) && isApproved(userId);

        // drivers of this DSP can read all scores (for ranking view)
        allow read: if isDriverOf(userId) && isApproved(userId);
      }

      // ---------- FAQs ----------
      // users/{userId}/faqs/{faqId}
      match /faqs/{faqId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Drivers of this DSP can read FAQs
        allow read: if isDriverOf(userId) && isApproved(userId);
      }

      // users/{userId}/faqs_localized/{faqId}
      match /faqs_localized/{faqId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Drivers of this DSP can read localized overrides
        allow read: if isDriverOf(userId) && isApproved(userId);
      }

      // users/{userId}/settings/{settingId}
      match /settings/{settingId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Drivers of this DSP can read settings (e.g. dispatcher pill, resources)
        allow read: if (isDriverOf(userId) || isDriverOfByToken(userId))
          && isApproved(userId);
      }

      // ---------- DA Academy Tests ----------
      // users/{userId}/academy_tests/{testId}
      match /academy_tests/{testId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Drivers of this DSP can read test metadata
        allow read: if (isDriverOf(userId) || isDriverOfByToken(userId))
          && isApproved(userId);

        // users/{userId}/academy_tests/{testId}/questions/{questionId}
        match /questions/{questionId} {
          // DSP/admin full access for own account
          allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

          // Drivers of this DSP can read test questions
          allow read: if (isDriverOf(userId) || isDriverOfByToken(userId))
            && isApproved(userId);
        }
      }

      // ---------- DA Academy Results ----------
      // users/{userId}/academy_test_results/{testId}/drivers/{driverId}
      match /academy_test_results/{testId} {
        // DSP/admin can manage and read aggregate result trees
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        match /drivers/{driverId} {
          // DSP/admin full access for own account
          allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

          // Driver can read only own result doc
          allow read: if (isDriverOf(userId) || isDriverOfByToken(userId))
            && isApproved(userId)
            && driverTransporterMatches(driverId);

          // Driver can create/update only own result doc
          allow create, update: if (isDriverOf(userId) || isDriverOfByToken(userId))
            && isApproved(userId)
            && driverTransporterMatches(driverId)
            && request.resource.data.driverTransporterId == driverId
            && request.resource.data.testId == testId;
        }
      }

      // ---------- driver master data ----------
      // users/{userId}/drivers/{driverId}   (driverId == TransporterID)
      match /drivers/{driverId} {
      
      	// ---------- driver notifications ----------
        match /notifications/{notificationId} {
          // DSP can create notifications for drivers
          allow create: if isSelf(userId) && isApproved(userId);

          // ✅ DSP can READ driver notifications (needed for History popup)
          allow read: if isSelf(userId) && isApproved(userId);

          // Driver can read + update (mark read / confirm)
          allow read, update: if isDriverOf(userId)
            && me().data.transporterId == driverId;
        }

        // ---------- driver academy tests ----------
        // users/{userId}/drivers/{driverId}/academy_tests/{testId}
        match /academy_tests/{testId} {
          // DSP/admin can publish/sync academy tests to driver docs
          allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

          // Driver can read own assigned test doc
          allow read: if (isDriverOf(userId) || isDriverOfByToken(userId))
            && isApproved(userId)
            && driverTransporterMatches(driverId);

          // Driver can submit own test attempts
          allow create, update: if (isDriverOf(userId) || isDriverOfByToken(userId))
            && isApproved(userId)
            && driverTransporterMatches(driverId)
            && request.resource.data.driverTransporterId == driverId
            && request.resource.data.testId == testId;
        }


        // DSP can fully manage its driver list
        allow read: if isSelf(userId) && isApproved(userId);
        allow create, delete: if isSelf(userId) && isApproved(userId);
        allow update: if isSelf(userId) && isApproved(userId);

        // Driver can read + update ONLY his own driver doc
        allow read, update: if isDriverOf(userId)
          && me().data.transporterId == driverId;

        // ---------- driver documents subcollection ----------
        match /documents/{docId} {
          allow read, write: if isSelf(userId) && isApproved(userId)
            || (isDriverOf(userId) && me().data.transporterId == driverId);
        }
      }
    }

  }
}
