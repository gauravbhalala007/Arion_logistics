// ============================================================
// VERALTETE KOPIE - WIRD NICHT MEHR DEPLOYED.
// Massgeblich sind die Dateien in firebase/ (dort liegt die
// Backend-Konfiguration inkl. Functions und Indexes).
// Diese Datei bleibt nur als Referenz erhalten, bis geklaert ist,
// welcher Rules-Stand aktuell live in Firebase aktiv ist.
// Siehe DEPLOYMENT.md -> 'Offener Punkt: Firestore-Rules'.
// ============================================================
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
