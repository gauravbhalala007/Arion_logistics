rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Read the caller's user doc safely
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && me().data.role == 'admin';
    }

    function isDeveloper() {
      return signedIn() && me().data.role == 'developer';
    }

    // "staff" for feedback handling should be only developers.
    // Admins/DSPs must not see each other's feedback.
    function isFeedbackStaff() {
      return isDeveloper();
    }

    function isApproved(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.approved == true;
    }

    // driver user created by Cloud Function
    function isDriver() {
      return signedIn() && me().data.role == 'driver';
    }

    // is the caller a driver that belongs to this DSP userId?
    // (requires users/{driverUid} to have a field "dspUid")
    function isDriverOf(userId) {
      return isDriver() && me().data.dspUid == userId;
    }

    // Fallback for legacy driver accounts that rely on custom claims.
    function isDriverOfByToken(userId) {
      return signedIn()
        && request.auth.token.role == 'driver'
        && request.auth.token.dspUid == userId;
    }

    function isDriverForUser(userId) {
      return isDriverOf(userId) || isDriverOfByToken(userId);
    }

    function companyScope() {
      return request.auth.uid;
    }

    function fleetCompanyScope() {
      return request.auth.uid;
    }

    function roleValue() {
      return me().data.role == null ? '' : me().data.role;
    }

    function isApprovedFleetManager() {
      return signedIn()
        && isApproved(request.auth.uid)
        && roleValue().matches('(?i)^(admin|user|developer)$');
    }

    function isApprovedFleetViewer() {
      return signedIn()
        && isApproved(request.auth.uid)
        && roleValue().matches('(?i)^(admin|user|developer)$');
    }

    function fleetScopeMatchesUser(userId) {
      return signedIn()
        && (
          userId == request.auth.uid
          || (me().data.dspUid != null && me().data.dspUid == userId)
          || (request.auth.token.dspUid != null && request.auth.token.dspUid == userId)
        );
    }

    function isVehicleManager(userId) {
      return signedIn()
        && fleetScopeMatchesUser(userId)
        && isApproved(request.auth.uid)
        && roleValue().matches('(?i)^(admin|user|developer)$');
    }

    function isVehicleCategory(value) {
      return value in [
        'ARMADA',
        'AMAZON_PAID_RENTAL',
        'SELF_SOURCED_RENTAL',
        'SELF_OWNED_RENTAL',
      ];
    }

    function isVehicleFuelType(value) {
      return value in [
        'DIESEL',
        'PETROL',
        'ELECTRIC',
        'HYBRID',
      ];
    }

    function isVehicleStatusValue(value) {
      return value in [
        'ACTIVE',
        'GROUNDED',
        'IN_SERVICE',
        'DEFLEETED',
      ];
    }

    function isVehicleDateString(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validVehicleMetadata(data) {
      return data.metadata is map
        && (
          data.category == 'ARMADA'
            ? data.metadata.keys().hasOnly([
                'armadaId',
                'armadaCompanyName',
                'contractStartDate',
                'contractEndDate',
              ])
              && data.metadata.armadaId is string
              && data.metadata.armadaId != ''
              && data.metadata.armadaCompanyName is string
              && data.metadata.armadaCompanyName != ''
              && isVehicleDateString(data.metadata.contractStartDate)
              && isVehicleDateString(data.metadata.contractEndDate)
            : data.category == 'AMAZON_PAID_RENTAL'
            ? data.metadata.keys().hasOnly([
                'rentalCompanyName',
                'contractNumber',
                'rentalStartDate',
                'rentalEndDate',
              ])
              && data.metadata.rentalCompanyName is string
              && data.metadata.rentalCompanyName != ''
              && data.metadata.contractNumber is string
              && data.metadata.contractNumber != ''
              && isVehicleDateString(data.metadata.rentalStartDate)
              && isVehicleDateString(data.metadata.rentalEndDate)
            : data.category == 'SELF_SOURCED_RENTAL'
            ? data.metadata.keys().hasOnly([
                'ownerName',
                'ownerContactNumber',
                'rentalAgreementNumber',
                'rentalStartDate',
                'rentalEndDate',
              ])
              && data.metadata.ownerName is string
              && data.metadata.ownerName != ''
              && data.metadata.ownerContactNumber is string
              && data.metadata.ownerContactNumber != ''
              && data.metadata.rentalAgreementNumber is string
              && data.metadata.rentalAgreementNumber != ''
              && isVehicleDateString(data.metadata.rentalStartDate)
              && isVehicleDateString(data.metadata.rentalEndDate)
            : data.category == 'SELF_OWNED_RENTAL'
            ? data.metadata.keys().hasOnly([
                'ownershipType',
                'purchaseDate',
              ])
              && data.metadata.ownershipType is string
              && data.metadata.ownershipType != ''
              && isVehicleDateString(data.metadata.purchaseDate)
            : false
        );
    }

    function validVehicleDocument(data, userId, plateNumber) {
      return data.keys().hasOnly([
          'dspUid',
          'plateNumber',
          'category',
          'brand',
          'model',
          'manufacturingYear',
          'vinNumber',
          'fuelType',
          'status',
          'serviceEndDate',
          'metadata',
          'notes',
          'isDeleted',
          'createdAt',
          'updatedAt',
        ])
        && data.dspUid == userId
        && data.plateNumber == plateNumber
        && data.category is string
        && isVehicleCategory(data.category)
        && data.brand is string
        && data.brand != ''
        && data.model is string
        && data.model != ''
        && data.manufacturingYear is number
        && data.vinNumber is string
        && data.vinNumber != ''
        && data.fuelType is string
        && isVehicleFuelType(data.fuelType)
        && data.status is string
        && isVehicleStatusValue(data.status)
        && (!('serviceEndDate' in data)
          || data.serviceEndDate == null
          || isVehicleDateString(data.serviceEndDate))
        && data.notes is string
        && data.isDeleted is bool
        && validVehicleMetadata(data);
    }

    function isVehicleDocumentManager(userId) {
      return signedIn()
        && fleetScopeMatchesUser(userId)
        && isApproved(request.auth.uid)
        && roleValue().matches('(?i)^(admin|user|developer)$');
    }

    function validVehicleSubDocumentDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validVehicleDocumentRecord(data, userId, plateNumber, documentId) {
      return data.keys().hasOnly([
          'documentId',
          'dspUid',
          'plateNumber',
          'documentType',
          'documentNumber',
          'expiryDate',
          'fileUrl',
          'fileName',
          'fileType',
          'notes',
          'isDeleted',
          'createdAt',
          'updatedAt',
        ])
        && data.documentId == documentId
        && data.dspUid == userId
        && data.plateNumber == plateNumber
        && data.documentType is string
        && data.documentType != ''
        && data.documentNumber is string
        && validVehicleSubDocumentDate(data.expiryDate)
        && data.fileUrl is string
        && data.fileName is string
        && data.fileName != ''
        && data.fileType is string
        && data.fileType != ''
        && data.notes is string
        && data.isDeleted is bool;
    }

    function isVehicleEventManager(userId) {
      return signedIn()
        && fleetScopeMatchesUser(userId)
        && isApproved(request.auth.uid)
        && roleValue().matches('(?i)^(admin|user|developer)$');
    }

    function allowedVehicleEventKeys() {
      return [
        'eventId',
        'dspUid',
        'plateNumber',
        'eventType',
        'title',
        'eventDate',
        'metadata',
        'fileUrl',
        'fileName',
        'fileType',
        'notes',
        'isDeleted',
        'createdAt',
        'updatedAt',
      ];
    }

    function validAccidentMetadata(metadata) {
      return metadata is map
        && metadata.keys().hasOnly([
          'location',
          'damageLevel',
          'policeReportNumber',
          'insuranceClaimNumber',
        ])
        && (!('location' in metadata) || metadata.location is string)
        && (!('damageLevel' in metadata) || metadata.damageLevel is string)
        && (!('policeReportNumber' in metadata) || metadata.policeReportNumber is string)
        && (!('insuranceClaimNumber' in metadata) || metadata.insuranceClaimNumber is string);
    }

    function validVehicleEventMetadata(data) {
      return data.metadata is map
        && (
          data.eventType == 'ACCIDENT'
            ? validAccidentMetadata(data.metadata)
            : data.metadata.keys().size() == 0
        );
    }

    function validVehicleEventRecord(data, userId, plateNumber, eventId) {
      return data.keys().hasOnly(allowedVehicleEventKeys())
        && data.eventId == eventId
        && data.dspUid == userId
        && data.plateNumber == plateNumber
        && data.eventType is string
        && data.eventType != ''
        && data.title is string
        && data.title != ''
        && validVehicleSubDocumentDate(data.eventDate)
        && validVehicleEventMetadata(data)
        && data.fileUrl is string
        && data.fileName is string
        && data.fileType is string
        && data.notes is string
        && data.isDeleted is bool;
    }

    function fleetDocScope(data) {
      return  data.dspUid;
    }

    function isFleetType(value) {
      return value in [
        'armada',
        'amazon_paid_rental',
        'self_sourced_rental',
        'self_owned_rental',
      ];
    }

    function isFleetEventType(value) {
      return value in [
        'registration',
        'status_change',
        'tire_change',
        'service_maintenance',
        'tuv_inspection',
        'accident',
        'damage',
        'rental_contract_change',
        'note',
      ];
    }

    function optionalString(data, field) {
      return !(field in data) || data[field] == null || data[field] is string;
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] == null || data[field] is timestamp;
    }

    function optionalNumber(data, field) {
      return !(field in data) || data[field] == null || data[field] is number;
    }

    function validFleetVehicleBase(data, userId, vehicleId) {
      return data.vehicleNumber == vehicleId
        && fleetDocScope(data) == userId
        && data.status in [
          'active',
          'grounded',
          'in_service',
          'defleeted',
        ]
        && (!('model' in data) || data.model is string)
        && (!('fleetType' in data) || data.fleetType == null || isFleetType(data.fleetType))
        && optionalString(data, 'providerOrOwnerName')
        && optionalString(data, 'contractReference')
        && optionalString(data, 'notes')
        && optionalTimestamp(data, 'contractStartDate')
        && optionalTimestamp(data, 'contractEndDate')
        && optionalTimestamp(data, 'serviceStartDate')
        && optionalTimestamp(data, 'serviceEndDate')
        && optionalTimestamp(data, 'createdAt')
        && optionalTimestamp(data, 'updatedAt')
        && optionalNumber(data, 'monthlyRateEur')
        && optionalNumber(data, 'purchaseValueEur');
    }

    function validFleetVehicleTypeRequirements(data) {
      return !('fleetType' in data)
        || data.fleetType == null
        || (
          data.fleetType == 'self_owned_rental'
            ? data.providerOrOwnerName is string
              && data.providerOrOwnerName != ''
              && data.purchaseValueEur is number
            : data.providerOrOwnerName is string
              && data.providerOrOwnerName != ''
              && data.contractReference is string
              && data.contractReference != ''
              && data.contractStartDate is timestamp
              && data.monthlyRateEur is number
        );
    }

    function validFleetVehicleTypeRequirementsFleetHub(data) {
      return !('fleetType' in data)
        || data.fleetType == null
        || (
          data.fleetType == 'self_owned_rental'
            ? optionalString(data, 'providerOrOwnerName')
              && optionalString(data, 'contractReference')
              && optionalTimestamp(data, 'contractStartDate')
              && optionalTimestamp(data, 'contractEndDate')
              && optionalNumber(data, 'monthlyRateEur')
              && optionalNumber(data, 'purchaseValueEur')
            : data.providerOrOwnerName is string
              && data.providerOrOwnerName != ''
              && data.contractReference is string
              && data.contractReference != ''
              && data.contractStartDate is timestamp
              && optionalTimestamp(data, 'contractEndDate')
              && optionalNumber(data, 'monthlyRateEur')
              && optionalNumber(data, 'purchaseValueEur')
        );
    }


    function driverTransporterId() {
      return isDriver() ? me().data.transporterId : request.auth.token.transporterId;
    }

    // ------------------------------------------------------------------------
    // Feedback (global collection)
    // ------------------------------------------------------------------------
    match /feedback/{feedbackId} {
      // Non-driver users can submit feedback for themselves once approved.
      allow create: if signedIn()
        && isApproved(request.auth.uid)
        && me().data.role != 'driver'
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'open';

      // Developers can read everything; submitters can read their own items.
      allow read: if (isFeedbackStaff() && isApproved(request.auth.uid))
        || (signedIn() && resource.data.createdByUid == request.auth.uid);

      // Only developers can update/delete feedback.
      allow update, delete: if isFeedbackStaff() && isApproved(request.auth.uid);
    }

    match /users/{userId} {
    
    	// ---------- admin notifications ----------
      match /notifications/{notificationId} {
        // Admin (DSP owner) can create + read notification history
        allow read, write: if isSelf(userId) && isApproved(userId);
      }
      
      // Created by the user at signup (DSP/admin + also driver profiles)
      allow create: if isSelf(userId);

      // Everyone can read their OWN user doc; admin can read all
      allow read: if isSelf(userId) || isAdmin();

      // Only admins may update/delete user docs (for now)
      allow update: if isAdmin() || isSelf(userId); 
      allow delete: if isAdmin();

      match /vehicles/{plateNumber} {
        allow get, list: if isVehicleManager(userId);

        allow create: if isVehicleManager(userId)
          && validVehicleDocument(request.resource.data, userId, plateNumber)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isVehicleManager(userId)
          && resource.data.dspUid == userId
          && request.resource.data.dspUid == resource.data.dspUid
          && request.resource.data.plateNumber == resource.data.plateNumber
          && validVehicleDocument(request.resource.data, userId, plateNumber)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if isVehicleManager(userId)
          && resource.data.dspUid == userId;

        match /documents/{documentId} {
          allow read: if isVehicleDocumentManager(userId);

          allow create: if isVehicleDocumentManager(userId)
            && validVehicleDocumentRecord(
              request.resource.data,
              userId,
              plateNumber,
              documentId
            )
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;

          allow update: if isVehicleDocumentManager(userId)
            && resource.data.dspUid == userId
            && resource.data.plateNumber == plateNumber
            && request.resource.data.dspUid == resource.data.dspUid
            && request.resource.data.plateNumber == resource.data.plateNumber
            && request.resource.data.documentId == resource.data.documentId
            && validVehicleDocumentRecord(
              request.resource.data,
              userId,
              plateNumber,
              documentId
            )
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time;

          allow delete: if isVehicleDocumentManager(userId)
            && resource.data.dspUid == userId
            && resource.data.plateNumber == plateNumber;
        }

        match /events/{eventId} {
          allow read: if isVehicleEventManager(userId);

          allow create: if isVehicleEventManager(userId)
            && validVehicleEventRecord(
              request.resource.data,
              userId,
              plateNumber,
              eventId
            )
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;

          allow update: if isVehicleEventManager(userId)
            && resource.data.dspUid == userId
            && resource.data.plateNumber == plateNumber
            && request.resource.data.dspUid == resource.data.dspUid
            && request.resource.data.plateNumber == resource.data.plateNumber
            && request.resource.data.eventId == resource.data.eventId
            && validVehicleEventRecord(
              request.resource.data,
              userId,
              plateNumber,
              eventId
            )
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time;

          allow delete: if isVehicleEventManager(userId)
            && resource.data.dspUid == userId
            && resource.data.plateNumber == plateNumber;
        }
      }

      // ---------- reports (scorecards) ----------
      // users/{userId}/reports/{reportId}
      match /reports/{reportId} {
        // DSP itself can read + write its own reports (and must be approved)
        allow read: if isSelf(userId) && isApproved(userId);
        allow write: if isSelf(userId) && isApproved(userId);

        // Drivers of this DSP can READ reports (for dashboard)
        allow read: if isDriverForUser(userId) && isApproved(userId);

        // per-report driver name mappings
        match /driverNames/{nameId} {
          // DSP full access
          allow read: if isSelf(userId) && isApproved(userId);
          allow write: if isSelf(userId) && isApproved(userId);

          // drivers of this DSP can read for display
          allow read: if isDriverForUser(userId) && isApproved(userId);
        }
      }

      // ---------- published waveplans ----------
      // users/{userId}/published_waveplans/{date}
      // Admin (DSP) writes the daily Waveplan when they hit Publish.
      // Drivers of this DSP read it to see their assignment + carpool tab.
      match /published_waveplans/{date} {
        allow read, write: if isSelf(userId) && isApproved(userId);
        allow read: if isDriverForUser(userId) && isApproved(userId);
      }

      // ---------- calendar events ----------
      // users/{userId}/calendar_events/{eventId}
      // Admin-only — calendar lives entirely in the admin area.
      match /calendar_events/{eventId} {
        allow read, write: if isSelf(userId) && isApproved(userId);
      }

      // ---------- scores for a report ----------
      // users/{userId}/scores/{scoreId}
      match /scores/{scoreId} {
        // DSP full access
        allow read: if isSelf(userId) && isApproved(userId);
        allow write: if isSelf(userId) && isApproved(userId);

        // drivers of this DSP can read all scores (for ranking view)
        allow read: if isDriverForUser(userId) && isApproved(userId);
      }

      // ---------- task sheet ----------
      // users/{userId}/tasks/{taskId}
      match /tasks/{taskId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Driver can only see tasks assigned to their transporterId
        allow read: if isDriverForUser(userId)
          && isApproved(userId)
          && resource.data.assignedTransporterId == driverTransporterId();

        // Driver can only update limited status fields on their own assigned tasks
        allow update: if isDriverForUser(userId)
          && isApproved(userId)
          && resource.data.assignedTransporterId == driverTransporterId()
          && request.resource.data.assignedTransporterId == resource.data.assignedTransporterId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'status',
            'completedConfirmed',
            'completedConfirmedAt',
            'updatedAt',
            'respondedAt',
            'feedbackText',
            'feedbackSelectedOption',
          ])
          && request.resource.data.status in ['pending', 'in_progress', 'completed'];
      }

      // ---------- FAQs ----------
      // users/{userId}/faqs/{faqId}
      match /faqs/{faqId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Drivers of this DSP can read FAQs
        allow read: if isDriverForUser(userId) && isApproved(userId);
      }

      // users/{userId}/faqs_localized/{faqId}
      match /faqs_localized/{faqId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Drivers of this DSP can read localized overrides
        allow read: if isDriverForUser(userId) && isApproved(userId);
      }

      // users/{userId}/settings/{settingId}
      match /settings/{settingId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Drivers of this DSP can read settings (e.g. academy/faq resources)
        allow read: if isDriverForUser(userId) && isApproved(userId);
      }

      // ---------- Shift Plans ----------
      // users/{userId}/shift_plans/{shiftId}
      match /shift_plans/{shiftId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Driver can read only own assigned shifts
        allow read: if isDriverForUser(userId)
          && isApproved(userId)
          && resource.data.driverTransporterId == driverTransporterId();
      }

      // ---------- Absence Requests ----------
      // users/{userId}/absence_requests/{requestId}
      match /absence_requests/{requestId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Driver can create and read only own requests
        allow create: if isDriverForUser(userId)
          && isApproved(userId)
          && request.resource.data.driverTransporterId == driverTransporterId()
          && request.resource.data.status == 'pending';

        allow read: if isDriverForUser(userId)
          && isApproved(userId)
          && resource.data.driverTransporterId == driverTransporterId();
      }

      // ---------- Incident Reports ----------
      // users/{userId}/incident_reports/{reportId}
      match /incident_reports/{reportId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Driver can create and read only own incident reports
        allow create: if isDriverForUser(userId)
          && isApproved(userId)
          && request.resource.data.driverTransporterId == driverTransporterId();

        allow read: if isDriverForUser(userId)
          && isApproved(userId)
          && resource.data.driverTransporterId == driverTransporterId();
      }

      // ---------- DA Academy Tests ----------
      // users/{userId}/academy_tests/{testId}
      match /academy_tests/{testId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Drivers of this DSP can read test metadata
        allow read: if isDriverForUser(userId)
          && isApproved(userId);

        // users/{userId}/academy_tests/{testId}/questions/{questionId}
        match /questions/{questionId} {
          // DSP/admin full access for own account
          allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

          // Drivers of this DSP can read test questions
          allow read: if isDriverForUser(userId)
            && isApproved(userId);
        }
      }

      // ---------- DA Academy Results ----------
      // users/{userId}/academy_test_results/{testId}/drivers/{driverId}
      match /academy_test_results/{testId} {
        // DSP/admin can manage and read aggregate result trees
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        match /drivers/{driverId} {
          // DSP/admin full access for own account
          allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

          // Driver can read only own result doc
          allow read: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId;

          // Driver can create/update only own result doc
          allow create, update: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId
            && request.resource.data.driverTransporterId == driverId
            && request.resource.data.testId == testId;
        }
      }

      // ---------- driver master data ----------
      // users/{userId}/drivers/{driverId}   (driverId == TransporterID)
      match /drivers/{driverId} {
      
      	// ---------- driver notifications ----------
        match /notifications/{notificationId} {
          // DSP can create notifications for drivers
          allow create: if isSelf(userId) && isApproved(userId);

          // ✅ DSP can READ driver notifications (needed for History popup)
          allow read: if isSelf(userId) && isApproved(userId);

          // Driver can read + update (mark read / confirm)
          allow read, update: if isDriverForUser(userId)
            && driverTransporterId() == driverId;
        }

        // ---------- driver academy tests ----------
        // users/{userId}/drivers/{driverId}/academy_tests/{testId}
        match /academy_tests/{testId} {
          // DSP/admin can publish/sync academy tests to driver docs
          allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

          // Driver can read own assigned test doc
          allow read: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId;

          // Driver can submit own test attempts
          allow create, update: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId
            && request.resource.data.driverTransporterId == driverId
            && request.resource.data.testId == testId;
        }

        // ---------- driver FAQ training ----------
        // users/{userId}/drivers/{driverId}/faq_training/{date}
        // Daily completion record written when the driver finishes
        // the FAQ Training quiz.
        match /faq_training/{date} {
          // DSP/admin can read+manage their drivers' progress
          allow read, create, update, delete:
            if isSelf(userId) && isApproved(userId);

          // Driver can read + write their own training records
          allow read, create, update: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId;
        }

        // ---------- driver shifts ----------
        // users/{userId}/drivers/{driverId}/shifts/{shiftId}
        match /shifts/{shiftId} {
          // DSP/admin full access for own account
          allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

          // Driver can read own shifts
          allow read: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId;
        }

        // ---------- driver absence requests ----------
        // users/{userId}/drivers/{driverId}/absence_requests/{requestId}
        match /absence_requests/{requestId} {
          // DSP/admin full access for own account
          allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

          // Driver can create/read own requests
          allow create: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId
            && request.resource.data.driverTransporterId == driverId
            && request.resource.data.status == 'pending';

          allow read: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId;
        }

        // ---------- driver incident reports ----------
        // users/{userId}/drivers/{driverId}/incident_reports/{reportId}
        match /incident_reports/{reportId} {
          // DSP/admin full access for own account
          allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

          // Driver can create/read/update only own incident report docs
          allow read: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId;

          allow create, update: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId
            && request.resource.data.driverTransporterId == driverId;
        }

        // DSP can fully manage its driver list
        allow read: if isSelf(userId) && isApproved(userId);
        allow create, delete: if isSelf(userId) && isApproved(userId);
        allow update: if isSelf(userId) && isApproved(userId);

        // Driver can read + update ONLY his own driver doc
        allow read, update: if isDriverForUser(userId)
          && driverTransporterId() == driverId;

        // ---------- driver documents subcollection ----------
        match /documents/{docId} {
          allow read, write: if isSelf(userId) && isApproved(userId)
            || (isDriverForUser(userId) && driverTransporterId() == driverId);
        }
      }
    }
  }
}
