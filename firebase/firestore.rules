rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Read the caller's user doc safely
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && me().data.role == 'admin';
    }

    function isDeveloper() {
      return signedIn() && me().data.role == 'developer';
    }

    function isStaff() {
      return isAdmin() || isDeveloper();
    }

    function isApproved(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.approved == true;
    }

    // driver user created by Cloud Function
    function isDriver() {
      return signedIn() && me().data.role == 'driver';
    }

    // is the caller a driver that belongs to this DSP userId?
    // (requires users/{driverUid} to have a field "dspUid")
    function isDriverOf(userId) {
      return isDriver() && me().data.dspUid == userId;
    }

    // Fallback for legacy driver accounts that rely on custom claims.
    function isDriverOfByToken(userId) {
      return signedIn()
        && request.auth.token.role == 'driver'
        && request.auth.token.dspUid == userId;
    }

    function isDriverForUser(userId) {
      return isDriverOf(userId) || isDriverOfByToken(userId);
    }

    function driverTransporterId() {
      return isDriver() ? me().data.transporterId : request.auth.token.transporterId;
    }

    // ------------------------------------------------------------------------
    // Feedback (global collection)
    // ------------------------------------------------------------------------
    match /feedback/{feedbackId} {
      // Non-driver users can submit feedback for themselves once approved.
      allow create: if signedIn()
        && isApproved(request.auth.uid)
        && me().data.role != 'driver'
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'open';

      // Staff can read everything; submitters can read their own items.
      allow read: if (isStaff() && isApproved(request.auth.uid))
        || (signedIn() && resource.data.createdByUid == request.auth.uid);

      // Only staff can update status/metadata.
      allow update, delete: if isStaff() && isApproved(request.auth.uid);
    }

    match /users/{userId} {
    
    	// ---------- admin notifications ----------
      match /notifications/{notificationId} {
        // Admin (DSP owner) can create + read notification history
        allow read, write: if isSelf(userId) && isApproved(userId);
      }
      
      // Created by the user at signup (DSP/admin + also driver profiles)
      allow create: if isSelf(userId);

      // Everyone can read their OWN user doc; admin can read all
      allow read: if isSelf(userId) || isAdmin();

      // Only admins may update/delete user docs (for now)
      allow update: if isAdmin() || isSelf(userId); 
      allow delete: if isAdmin();

      // ---------- reports (scorecards) ----------
      // users/{userId}/reports/{reportId}
      match /reports/{reportId} {
        // DSP itself can read + write its own reports (and must be approved)
        allow read: if isSelf(userId) && isApproved(userId);
        allow write: if isSelf(userId) && isApproved(userId);

        // Drivers of this DSP can READ reports (for dashboard)
        allow read: if isDriverForUser(userId) && isApproved(userId);

        // per-report driver name mappings
        match /driverNames/{nameId} {
          // DSP full access
          allow read: if isSelf(userId) && isApproved(userId);
          allow write: if isSelf(userId) && isApproved(userId);

          // drivers of this DSP can read for display
          allow read: if isDriverForUser(userId) && isApproved(userId);
        }
      }

      // ---------- scores for a report ----------
      // users/{userId}/scores/{scoreId}
      match /scores/{scoreId} {
        // DSP full access
        allow read: if isSelf(userId) && isApproved(userId);
        allow write: if isSelf(userId) && isApproved(userId);

        // drivers of this DSP can read all scores (for ranking view)
        allow read: if isDriverForUser(userId) && isApproved(userId);
      }

      // ---------- task sheet ----------
      // users/{userId}/tasks/{taskId}
      match /tasks/{taskId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Driver can only see tasks assigned to their transporterId
        allow read: if isDriverForUser(userId)
          && isApproved(userId)
          && resource.data.assignedTransporterId == driverTransporterId();

        // Driver can only update limited status fields on their own assigned tasks
        allow update: if isDriverForUser(userId)
          && isApproved(userId)
          && resource.data.assignedTransporterId == driverTransporterId()
          && request.resource.data.assignedTransporterId == resource.data.assignedTransporterId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'status',
            'completedConfirmed',
            'completedConfirmedAt',
            'updatedAt',
            'respondedAt',
            'feedbackText',
            'feedbackSelectedOption',
          ])
          && request.resource.data.status in ['pending', 'in_progress', 'completed'];
      }

      // ---------- FAQs ----------
      // users/{userId}/faqs/{faqId}
      match /faqs/{faqId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Drivers of this DSP can read FAQs
        allow read: if isDriverForUser(userId) && isApproved(userId);
      }

      // users/{userId}/faqs_localized/{faqId}
      match /faqs_localized/{faqId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Drivers of this DSP can read localized overrides
        allow read: if isDriverForUser(userId) && isApproved(userId);
      }

      // users/{userId}/settings/{settingId}
      match /settings/{settingId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Drivers of this DSP can read settings (e.g. academy/faq resources)
        allow read: if isDriverForUser(userId) && isApproved(userId);
      }

      // ---------- Shift Plans ----------
      // users/{userId}/shift_plans/{shiftId}
      match /shift_plans/{shiftId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Driver can read only own assigned shifts
        allow read: if isDriverForUser(userId)
          && isApproved(userId)
          && resource.data.driverTransporterId == driverTransporterId();
      }

      // ---------- Absence Requests ----------
      // users/{userId}/absence_requests/{requestId}
      match /absence_requests/{requestId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Driver can create and read only own requests
        allow create: if isDriverForUser(userId)
          && isApproved(userId)
          && request.resource.data.driverTransporterId == driverTransporterId()
          && request.resource.data.status == 'pending';

        allow read: if isDriverForUser(userId)
          && isApproved(userId)
          && resource.data.driverTransporterId == driverTransporterId();
      }

      // ---------- Incident Reports ----------
      // users/{userId}/incident_reports/{reportId}
      match /incident_reports/{reportId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Driver can create and read only own incident reports
        allow create: if isDriverForUser(userId)
          && isApproved(userId)
          && request.resource.data.driverTransporterId == driverTransporterId();

        allow read: if isDriverForUser(userId)
          && isApproved(userId)
          && resource.data.driverTransporterId == driverTransporterId();
      }

      // ---------- DA Academy Tests ----------
      // users/{userId}/academy_tests/{testId}
      match /academy_tests/{testId} {
        // DSP/admin full access for own account
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        // Drivers of this DSP can read test metadata
        allow read: if isDriverForUser(userId)
          && isApproved(userId);

        // users/{userId}/academy_tests/{testId}/questions/{questionId}
        match /questions/{questionId} {
          // DSP/admin full access for own account
          allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

          // Drivers of this DSP can read test questions
          allow read: if isDriverForUser(userId)
            && isApproved(userId);
        }
      }

      // ---------- DA Academy Results ----------
      // users/{userId}/academy_test_results/{testId}/drivers/{driverId}
      match /academy_test_results/{testId} {
        // DSP/admin can manage and read aggregate result trees
        allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

        match /drivers/{driverId} {
          // DSP/admin full access for own account
          allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

          // Driver can read only own result doc
          allow read: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId;

          // Driver can create/update only own result doc
          allow create, update: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId
            && request.resource.data.driverTransporterId == driverId
            && request.resource.data.testId == testId;
        }
      }

      // ---------- driver master data ----------
      // users/{userId}/drivers/{driverId}   (driverId == TransporterID)
      match /drivers/{driverId} {
      
      	// ---------- driver notifications ----------
        match /notifications/{notificationId} {
          // DSP can create notifications for drivers
          allow create: if isSelf(userId) && isApproved(userId);

          // ✅ DSP can READ driver notifications (needed for History popup)
          allow read: if isSelf(userId) && isApproved(userId);

          // Driver can read + update (mark read / confirm)
          allow read, update: if isDriverForUser(userId)
            && driverTransporterId() == driverId;
        }

        // ---------- driver academy tests ----------
        // users/{userId}/drivers/{driverId}/academy_tests/{testId}
        match /academy_tests/{testId} {
          // DSP/admin can publish/sync academy tests to driver docs
          allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

          // Driver can read own assigned test doc
          allow read: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId;

          // Driver can submit own test attempts
          allow create, update: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId
            && request.resource.data.driverTransporterId == driverId
            && request.resource.data.testId == testId;
        }

        // ---------- driver shifts ----------
        // users/{userId}/drivers/{driverId}/shifts/{shiftId}
        match /shifts/{shiftId} {
          // DSP/admin full access for own account
          allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

          // Driver can read own shifts
          allow read: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId;
        }

        // ---------- driver absence requests ----------
        // users/{userId}/drivers/{driverId}/absence_requests/{requestId}
        match /absence_requests/{requestId} {
          // DSP/admin full access for own account
          allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

          // Driver can create/read own requests
          allow create: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId
            && request.resource.data.driverTransporterId == driverId
            && request.resource.data.status == 'pending';

          allow read: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId;
        }

        // ---------- driver incident reports ----------
        // users/{userId}/drivers/{driverId}/incident_reports/{reportId}
        match /incident_reports/{reportId} {
          // DSP/admin full access for own account
          allow read, create, update, delete: if isSelf(userId) && isApproved(userId);

          // Driver can create/read/update only own incident report docs
          allow read: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId;

          allow create, update: if isDriverForUser(userId)
            && isApproved(userId)
            && driverTransporterId() == driverId
            && request.resource.data.driverTransporterId == driverId;
        }


        // DSP can fully manage its driver list
        allow read: if isSelf(userId) && isApproved(userId);
        allow create, delete: if isSelf(userId) && isApproved(userId);
        allow update: if isSelf(userId) && isApproved(userId);

        // Driver can read + update ONLY his own driver doc
        allow read, update: if isDriverForUser(userId)
          && driverTransporterId() == driverId;

        // ---------- driver documents subcollection ----------
        match /documents/{docId} {
          allow read, write: if isSelf(userId) && isApproved(userId)
            || (isDriverForUser(userId) && driverTransporterId() == driverId);
        }
      }
    }
  }
}
